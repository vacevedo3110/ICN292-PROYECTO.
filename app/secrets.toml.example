# Copie este archivo a .streamlit/secrets.toml y complete los valores.
# .streamlit/secrets.toml NO se sube a GitHub (está en .gitignore): ahí van las contraseñas.

[mysql]
host = "localhost"
port = 3306
user = "altura_app"          # recomendado: un usuario propio, no root (ver README)
password = "CAMBIAR_ESTA_CLAVE"
database = "altura_db"
# unix_socket = "/tmp/mysql.sock"   # opcional, en vez de host/port

[n8n]
# URL de PRODUCCIÓN del webhook del flujo (termina en /webhook/..., no /webhook-test/...).
# El flujo debe estar activado en n8n para que responda.
webhook_url = "https://SU-INSTANCIA.app.n8n.cloud/webhook/presupuesto-emitido"
